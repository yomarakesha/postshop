    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "turkmenistan",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "maxzoom": 24,
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 9, 16, 13, 20, 16],
        "symbol-placement": "line",
        "text-max-angle": 30
