{
  "version": 8,
  "name": "Turkmenistan Custom",
  "metadata": {
    "openmaptiles:version": "3.x",
    "note": "Адрес сервера подставляется на клиенте из VITE_MAP_TILES_URL — в файле его нет намеренно."
  },
  "sources": {
    "turkmenistan": {
      "type": "vector",
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#e8e0d8"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "turkmenistan",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "neighbourhood"],
      "paint": {
        "fill-color": "#e8e0d8",
        "fill-opacity": 1
      }
    },
    {
      "id": "landuse-parks",
      "type": "fill",
      "source": "turkmenistan",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "grass", "garden", "pitch", "cemetery"],
      "paint": {
        "fill-color": "#c5dea6",
        "fill-opacity": 1
      }
    },
    {
      "id": "landuse-retail",
      "type": "fill",
      "source": "turkmenistan",
      "source-layer": "landuse",
      "filter": ["in", "class", "retail", "commercial"],
      "paint": {
        "fill-color": "#f5e4d3",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "turkmenistan",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {
        "fill-color": "#c5dea6",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "turkmenistan",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#a8cc88",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "turkmenistan",
      "source-layer": "landcover",
      "filter": ["in", "class", "sand", "beach"],
      "paint": {
        "fill-color": "#f0e6c8",
        "fill-opacity": 1
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "turkmenistan",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9ac0d6"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "turkmenistan",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#9ac0d6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 16, 4, 22, 8]
      }
    },
    {
      "id": "admin-country",
      "type": "line",
      "source": "turkmenistan",
      "source-layer": "boundary",
      "filter": ["all", ["<=", "admin_level", 2], ["==", "$type", "LineString"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#9a9488",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 10, 2.5, 22, 4]
      }
    },
    {
      "id": "admin-region",
      "type": "line",
      "source": "turkmenistan",
      "source-layer": "boundary",
      "filter": ["all", [">=", "admin_level", 4], ["<=", "admin_level", 6]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#b0a898",
        "line-dasharray": [3, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.3, 10, 1.5, 22, 3]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "turkmenistan",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#ddd6cc",
        "fill-outline-color": "#c9c2b8",
        "fill-opacity": 1
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "turkmenistan",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-extrusion-color": "#ddd6cc",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], 5],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.9
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "turkmenistan",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "path", "track"],
      "minzoom": 13,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f8f6f2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 18, 6, 22, 12]
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "turkmenistan",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f8f6f2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 18, 13, 22, 26]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "turkmenistan",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fce8a0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 18, 20, 22, 40]
