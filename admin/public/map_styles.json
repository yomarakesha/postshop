    {
      "id": "road-motorway",
      "type": "line",
      "source": "turkmenistan",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fad165",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.5, 18, 22, 22, 46]
