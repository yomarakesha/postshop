# This file lists all the environment variables your project needs to run.
# Copy this file to a new file named `.env` and fill in the values.
# Do NOT commit your `.env` file with real secrets to version control.
#
# Variables prefixed with VITE_ will be exposed to the frontend.

VITE_BACKEND_API_URL=
VITE_OPEN_API_URL=
# Панель отладки TanStack. По умолчанию выключена: её плашка висела в правом
# нижнем углу и перекрывала интерфейс. Поставьте 1, чтобы включить локально.
VITE_DEVTOOLS=
HOST=0.0.0.0
PORT=7001
NODE_ENV=production

# Адрес картографического сервера (тайлы, шрифты, значки).
# Прежний сервер отключён, нового пока нет — пока строка пуста, карта не
# рисуется и показывает объяснение вместо пустого поля.
VITE_MAP_TILES_URL=
